{
  "name": "bensampica.com Eleventy",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "onCreateCommand": "corepack enable",
  "updateContentCommand": "pnpm install --frozen-lockfile --prefer-offline",
  "postCreateCommand": "node --version && pnpm --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "ownable.ownable"
      ]
    }
  },
  "mounts": [
    "source=pnpm-store,target=/home/vscode/.local/share/pnpm,type=volume"
  ],
  "remoteUser": "vscode",
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Eleventy Server"
    }
  }
}
