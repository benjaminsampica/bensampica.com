<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ feedTitle }}</title>
    <link>{{ feedHome | siteUrl }}</link>
    <atom:link href="{{ feedUrl | siteUrl }}" rel="self" type="application/rss+xml" />
    <description>{{ feedDescription }}</description>
    <language>en-us</language>
    {% for post in feedPosts %}
      <item>
        <title>{{ post.data.title }}</title>
        <link>{{ post.url | siteUrl }}</link>
        <guid isPermaLink="true">{{ post.url | siteUrl }}</guid>
        <pubDate>{{ post.data.date | dateRfc822 }}</pubDate>
        <description>{{ post.data.summary }}</description>
        <content:encoded><![CDATA[{{ post.templateContent | htmlToAbsoluteUrls(post.url | siteUrl) | safe }}]]></content:encoded>
      </item>
    {% endfor %}
  </channel>
</rss>
