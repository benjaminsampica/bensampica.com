<article class="post-card">
  <a class="post-card__image" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
    <img{% if deferPostImages %} data-src="{{ post | postImage }}" data-deferred-image{% else %} src="{{ post | postImage }}"{% endif %} alt="" loading="lazy" decoding="async" width="1200" height="630">
  </a>
  <div class="post-card__body">
    <div class="post-card__meta">
      <time datetime="{{ post.data.date | dateIso }}">{{ post.data.date | dateReadable }}</time>
      <span aria-hidden="true">/</span>
      <span>{{ post.templateContent | readingTime }} min read</span>
    </div>
    {% set headingLevel = postHeadingLevel or 3 %}
    <h{{ headingLevel }}><a href="{{ post.url }}">{{ post.data.title }}</a></h{{ headingLevel }}>
    {% if post.data.subtitle %}<p class="post-card__subtitle">{{ post.data.subtitle }}</p>{% endif %}
    <p>{{ post.data.summary }}</p>
    <div class="post-card__footer">
      <div class="tag-row" aria-label="Topics">
        {% for tag in post.data.tags | take(3) %}
          <a class="tag" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>
        {% endfor %}
      </div>
      <a class="text-link" href="{{ post.url }}">Read article <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
